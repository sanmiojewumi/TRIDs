# Copy to .env at the repo root and to apps/api/.env. Never commit real secrets.

DATABASE_URL=postgresql://ninted:ninted@127.0.0.1:5432/ninted?schema=public
TEST_DATABASE_URL=postgresql://ninted:ninted@127.0.0.1:5432/ninted_test?schema=public

# Required. At least 32 characters. Generate with: openssl rand -base64 48
ACCESS_TOKEN_SECRET=
# 32-byte key, hex-encoded (64 hex characters). Generate with: openssl rand -hex 32
SECRET_ENCRYPTION_KEY=

WEB_ORIGIN=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://127.0.0.1:4000
API_INTERNAL_URL=http://127.0.0.1:4000

# Owner-supplied first super administrator. The seed refuses to invent a password.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Demo catalogue for local development only. Never enable in production.
SEED_DEMO=false
SEED_DEMO_PASSWORD=

# paystack (primary candidate) or flutterwave (alternative). Both stay inactive until keys exist.
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
# Automatic bank transfers stay off until counsel and the provider confirm settlement.
PAYSTACK_TRANSFERS_ENABLED=false

# Phase 2 own-rider network. Models and routes exist; they stay disabled until you turn this on.
PHASE2_LOGISTICS=false

SMTP_URL=
SMS_HTTP_URL=
SMS_API_KEY=
PUSH_HTTP_URL=
PUSH_API_KEY=

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
